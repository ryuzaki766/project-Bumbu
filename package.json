{
  "name": "alur-bumbu",
  "version": "1.0.0",
  "description": "Sistem Manajemen Alur Pesanan & Stok Bumbu Otomatis (Frontend & Backend Decoupled)",
  "type": "module",
  "scripts": {
    "start": "npm run --prefix backend start",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run --prefix backend start\" \"npm run --prefix frontend dev\"",
    "backend": "npm run --prefix backend start",
    "frontend": "npm run --prefix frontend dev",
    "build": "npm run --prefix frontend build",
    "test": "node backend/scripts/simulate_flow.js",
    "test:auth": "npm run --prefix backend test:auth",
    "test:redis": "node backend/scripts/test_redis_error.js"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "xlsx": "^0.18.5"
  }
}
